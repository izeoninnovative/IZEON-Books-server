// use prisma-8

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum PaymentPlan {
  LUMPSUM
  EMI
}

enum InvoiceType {
  GST
  NON_GST
}

enum EmiStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NETBANKING
  CHEQUE
}

enum ExpenseCategory {
  RENT
  UTILITIES
  MARKETING
  EQUIPMENT
  MAINTENANCE
  SALARY
  OTHER
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  role      Role     @default(HR)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  expenses  Expense[]
  salaries  SalaryPayment[]
  invoices  Invoice[]
  employee  Employee?
}

model Course {
  id            Int      @id @default(autoincrement())
  title         String
  code          String   @unique
  description   String?
  durationWeeks Int      @default(12)
  baseFee       Float
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
  students      Student[]
}

model Student {
  id        Int           @id @default(autoincrement())
  name      String
  email     String        @unique
  phone     String
  dob       String
  address   String?
  courseId  Int
  course    Course        @relation(fields: [courseId], references: [id])
  status    StudentStatus @default(ACTIVE)
  joinDate  TimestamptzString @default(now())
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  feePlans  FeePlan[]
  invoices  Invoice[]

  @@index([phone])
  @@index([courseId])
  @@index([status])
}

model FeePlan {
  id                Int          @id @default(autoincrement())
  studentId         Int
  student           Student      @relation(fields: [studentId], references: [id])
  planType          PaymentPlan  @default(LUMPSUM)
  invoiceType       InvoiceType  @default(GST)
  baseAmount        Float
  discountAmount    Float        @default(0)
  taxableAmount     Float
  gstRate           Float        @default(18)
  gstAmount         Float        @default(0)
  totalAmount       Float
  paidAmount        Float        @default(0)
  balanceAmount     Float
  totalInstallments Int          @default(1)
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()
  emiSchedules      EmiSchedule[]
  invoices          Invoice[]

  @@index([studentId])
}

model EmiSchedule {
  id            Int       @id @default(autoincrement())
  feePlanId     Int
  feePlan       FeePlan   @relation(fields: [feePlanId], references: [id])
  installmentNo Int
  amount        Float
  dueDate       TimestamptzString
  paidDate      TimestamptzString?
  status        EmiStatus @default(PENDING)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
  invoices      Invoice[]

  @@index([feePlanId])
  @@index([status])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNo      String        @unique
  studentId      Int
  student        Student       @relation(fields: [studentId], references: [id])
  feePlanId      Int
  feePlan        FeePlan       @relation(fields: [feePlanId], references: [id])
  emiScheduleId  Int?
  emiSchedule    EmiSchedule?  @relation(fields: [emiScheduleId], references: [id])
  
  // --- ADD THIS ---
  createdById    Int?          // Optional for existing rows, or make required if migrated
  createdBy      User?         @relation(fields: [createdById], references: [id])
  // ----------------
  
  invoiceType    InvoiceType
  paymentMethod  PaymentMethod @default(UPI)
  transactionRef String?
  amountPaid     Float
  taxableAmount  Float
  cgstAmount     Float         @default(0)
  sgstAmount     Float         @default(0)
  totalAmount    Float
  issuedAt       TimestamptzString @default(now())
  createdAt      TimestamptzString @default(now())

  @@index([studentId])
  @@index([feePlanId])
  @@index([createdById])
}


model Expense {
  id          Int             @id @default(autoincrement())
  title       String
  category    ExpenseCategory
  amount      Float
  expenseDate TimestamptzString @default(now())
  notes       String?
  createdById Int
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   TimestamptzString @default(now())

  @@index([category])
}

model Employee {
  id              Int            @id @default(autoincrement())
  empCode         String         @unique
  name            String
  email           String?
  phone           String?
  role            String
  department      String?
  joiningDate     String?
  baseSalary      Float          @default(0)
  appraisalDate   String?
  lastAppraisalDate String?
  lastAppraisalSalary Float?
  lastAppraisalIncrement Float?
  lastAppraisalNotes String?
  status          EmployeeStatus @default(ACTIVE)
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  notes           String?
  shiftInTime     String?        @default("09:30")
  shiftOutTime    String?        @default("18:30")
  gracePeriodMinutes Int?        @default(0)
  userId          Int?           @unique
  user            User?          @relation(fields: [userId], references: [id])
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
  salaries        SalaryPayment[]
  lopRecords      EmployeeLop[]
  attendances     EmployeeAttendance[]
  appraisals      EmployeeAppraisal[]

  @@index([empCode])
  @@index([status])
  @@index([userId])
}

model EmployeeAppraisal {
  id                  Int      @id @default(autoincrement())
  employeeId          Int
  employee            Employee @relation(fields: [employeeId], references: [id])
  previousSalary      Float
  newSalary           Float
  incrementAmount     Float
  incrementPercentage Float?
  appraisalDate       String
  nextAppraisalDate   String?
  rating              String?
  notes               String?
  createdAt           TimestamptzString @default(now())

  @@index([employeeId])
  @@index([appraisalDate])
}

model AttendancePolicy {
  id                  Int      @id @default(autoincrement())
  expectedInTime      String   @default("09:30")
  expectedOutTime     String   @default("18:30")
  gracePeriodMinutes  Int      @default(0)
  lateDeductionPerDay Float    @default(100)
  lateDeduction900    Float?   @default(100)
  lateDeduction930    Float?   @default(100)
  deductionType       String   @default("FLAT")
  geofenceEnabled     Boolean  @default(true)
  officeLatitude      Float    @default(13.0827)
  officeLongitude     Float    @default(80.2707)
  geofenceRadiusMeters Float   @default(50)
  officeAddress       String?  @default("IZEON INNOVATIVE, Tamil Nadu")
  createdAt           TimestamptzString @default(now())
  updatedAt           TimestamptzString @default(now())
}

model EmployeeAttendance {
  id                  Int      @id @default(autoincrement())
  employeeId          Int
  employee            Employee @relation(fields: [employeeId], references: [id])
  date                String
  inTime              String?
  outTime             String?
  workHours           Float    @default(0)
  isLate              Boolean  @default(false)
  lateMinutes         Int      @default(0)
  lateDeduction       Float    @default(0)
  status              String   @default("PRESENT")
  notes               String?
  punchLatitude       Float?
  punchLongitude      Float?
  punchDistanceMeters Float?
  createdAt           TimestamptzString @default(now())
  updatedAt           TimestamptzString @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model EmployeeLop {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id])
  month       Int
  year        Int
  lopDays     Float    @default(0)
  lopAmount   Float    @default(0)
  reason      String?
  createdAt   TimestamptzString @default(now())

  @@index([employeeId])
  @@index([year, month])
}

model SalaryPayment {
  id            Int           @id @default(autoincrement())
  employeeId    Int?
  employee      Employee?     @relation(fields: [employeeId], references: [id])
  employeeName  String
  employeeEmail String?
  role          String
  month         Int
  year          Int
  amount        Float
  baseSalary    Float?
  lopDays       Float?        @default(0)
  lopDeduction  Float?        @default(0)
  lateDays      Int?          @default(0)
  lateDeduction Float?        @default(0)
  paymentDate   TimestamptzString @default(now())
  paymentMethod PaymentMethod @default(NETBANKING)
  reference     String?
  notes         String?
  paidById      Int
  paidBy        User          @relation(fields: [paidById], references: [id])
  createdAt     TimestamptzString @default(now())

  @@index([year, month])
  @@index([employeeId])
}

model CompanyProfile {
  id          Int      @id @default(autoincrement())
  companyName String   @default("IZEON INNOVATIVE")
  tagline     String?  @default("Academy of Computer Software Training")
  gstin       String?
  address     String?  @default("Tamil Nadu, India")
  city        String?
  state       String?  @default("Tamil Nadu")
  pincode     String?
  phone       String?
  email       String?
  website     String?
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())
}